# OS / エディタ
.DS_Store
Thumbs.db

# 秘密情報
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/

# 一時生成物（学習用データ、公開用ディレクトリなど）
build/
_site/

# 画像生成環境（モデル本体は管理しない。備忘録だけ残す）
generator/models/*
!generator/models/.gitkeep
!generator/models/MODELS.md
generator/temp/

# 切り出し前の元シートと、そのメタデータ（人間が見やすい場所に置くが、Git には入れない）
generated/999_sheet/

# 実験 run は、テキスト（spec / scores / review / 画像ごとの .json など）と一覧画像（contact.webp）だけ管理する。
# 画像本体（PNG）と report.html は spec.json から再生成できるので管理しない（runs/README.md 参照）。
# 見本の 2 件（gap-09-scifi / idol-structured）は、PNG と report.html も追跡済み（チュートリアル用の例外）。
runs/*/images/*.png
runs/*/report.html

# 実使用の session（画像・選択の履歴）は管理しない。README だけ管理する（sessions/README.md 参照）
sessions/*
!sessions/README.md
